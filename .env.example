# ANIVIA environment configuration
# Copy this file to `.env.local` and adjust values. Never commit real secrets.

# Anime data source (no API keys required for the public APIs):
#   anilist — AniList GraphQL API, episode titles enriched from Jikan (default)
#   jikan   — Jikan v4 (unofficial MyAnimeList API)
#   api     — your own REST backend (set VITE_API_BASE_URL)
#   mock    — fictional offline demo catalog
VITE_ANIME_PROVIDER=anilist

# Optional endpoint overrides (e.g. a self-hosted Jikan instance or a caching proxy).
VITE_ANILIST_URL=https://graphql.anilist.co
VITE_JIKAN_URL=https://api.jikan.moe/v4

# Base URL of your own API (only used when VITE_ANIME_PROVIDER=api or VITE_VIDEO_PROVIDER=api).
VITE_API_BASE_URL=

# Which video provider to use: "mock" (default, simulated demo playback) or "api".
VITE_VIDEO_PROVIDER=mock

# Artificial latency (ms) added by mock providers so loading states are visible.
VITE_MOCK_LATENCY=350

# Public site URL used for canonical / Open Graph tags.
VITE_SITE_URL=https://anivia.example.com

# Supabase (accounts + library sync). Only the project URL and the PUBLISHABLE key belong here.
# Never put the database password or an sb_secret_ key in a VITE_ variable — it would be public.
# Set VITE_SUPABASE_URL= (empty) to run without accounts.
VITE_SUPABASE_URL=https://wnmvktajokjhufuzpamy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fr81aMF8zLh8ambsYTcJwg_SjxpX1DT

# Edge-cached AniList proxy served by the Cloudflare Worker (worker/index.ts).
# Auto-detected in production builds; set to an empty value to always call AniList directly.
# VITE_ANILIST_PROXY=/api/anilist
# Supabase Edge Function that stores anime data in the database (auto-detected; set to empty to disable)
# VITE_ANILIST_DB_PROXY=https://<project>.supabase.co/functions/v1/anilist-proxy

# Optional public contact details (hidden when empty)
VITE_SUPPORT_EMAIL=
VITE_SOCIAL_DISCORD=
VITE_SOCIAL_X=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_WEBSITE=

# Show pricing / upgrade UI (only once a payment provider is connected)
VITE_ENABLE_PRICING=false

# Cloudflare Web Analytics token (cookie-free statistics) — optional
VITE_CF_ANALYTICS_TOKEN=

# AniList API client (https://anilist.co/settings/developer) — PUBLIC client id only.
# The browser uses the implicit grant; never put the client secret in any VITE_ variable.
# For local development create a second AniList client with redirect URL http://localhost:5173
# and put its id in .env.local.
VITE_ANILIST_CLIENT_ID=52829
