{
  // Cloudflare Workers deployment for ANIVIA.
  // Build: `npm run build` → deploy: `npx wrangler deploy`
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anivia",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes such as /anime/123 or /browse.
    "not_found_handling": "single-page-application",
    // The Worker handles the AniList cache proxy and share previews; everything else is static.
    "run_worker_first": ["/api/*", "/anime/*", "/media/*"]
  },
  // Covers and banners uploaded to R2 (<anilistId>/<file>.jpg), served by worker/media.ts at /media/:id/cover|banner.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "yume-media" }],
  "vars": { "MEDIA_PUBLIC_URL": "https://media.animehub.hu" }
}
